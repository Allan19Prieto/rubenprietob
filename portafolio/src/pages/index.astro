---
import TarjetaProyecto from "../components/TarjetaProyecto.astro";
import { proyectos } from "../data/proyectos";
import Formularios from "../components/Formularios.astro";
import Ingresos from "../components/Ingresos.astro";
import UltimosArticulos from "../components/UltimosArticulos.astro";

const secciones = [
	{ id: "sobre-mi", nombre: "Sobre mí"},
	{ id: "proyectos", nombre: "Proyectos"},
	{ id: "blog", nombre: "Blog" },
	{ id: "contacto", nombre: "Contacto" },
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Proyectos, automatización y aprendizajes de Allan Ruben Prieto." />
		<meta name="generator" content={Astro.generator} />
		<title>Allan Prieto | Proyectos y tecnologías</title>
	</head>
	<body>
    <div class="resplandor-cursor" aria-hidden="true"></div>
    <div class="portafolio">
      <aside class="perfil">
        <header>
          <h1>Allan Prieto</h1>
          <a class="enlace-blog" href="/blog/">Leer mi blog →</a>

          <p class="profesion">
            Desarrollador & creador de productos
          </p>

          <p class="presentacion">
            Construyo aplicaciones, automatizaciones y herramientas
            para resolver problemas reales.
          </p>
        </header>

        <nav aria-label="Navegación principal">
          {
            secciones.map((seccion, indice) => (
              <a href={`#${seccion.id}`}>
                <span>{String(indice + 1).padStart(2, "0")}</span>
                {seccion.nombre}
              </a>
            ))
          }
        </nav>

        <Ingresos />
      </aside>

      <main>
        <section id="sobre-mi">
          <h2 class="titular">
            Ideas que se convierten en herramientas.
          </h2>
          <p>
            Me interesa conectar software, datos y procesos.
            Este es mi espacio para compartir lo que construyo
            y lo que voy aprendiendo.
          </p>
        </section>

        <section id="proyectos">
          <div class="encabezado-proyectos">
            <h2>Proyectos & productos</h2>
            <span>Conceptos para explorar</span>
          </div>

          <div class="lista-proyectos">
            {
            proyectos.map((proyecto) => (
              <TarjetaProyecto {...proyecto} />
            ))
            }
          </div>
        </section>

        <UltimosArticulos />

        <Formularios />

        <footer>Allan Prieto · Construyendo en público</footer>
      </main>
    </div>
  </body>
</html>

<script>
  const enlaces = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '.perfil nav a[href^="#"]'
    )
  );

  const destinos = enlaces.flatMap((enlace) => {
    const id = enlace.hash.slice(1);
    const seccion = document.getElementById(id);

    return seccion ? [{ enlace, seccion }] : [];
  });

  function actualizarSeccionActiva() {
    if (destinos.length === 0) return;

    const referencia = window.innerHeight * 0.35;
    let activo = destinos[0];

    for (const destino of destinos) {
      if (destino.seccion.getBoundingClientRect().top <= referencia) {
        activo = destino;
      }
    }

    for (const destino of destinos) {
      if (destino === activo) {
        destino.enlace.setAttribute("aria-current", "location");
      } else {
        destino.enlace.removeAttribute("aria-current");
      }
    }
  }

  let actualizacionPendiente = false;

  function solicitarActualizacion() {
    if (actualizacionPendiente) return;

    actualizacionPendiente = true;

    requestAnimationFrame(() => {
      actualizarSeccionActiva();
      actualizacionPendiente = false;
    });
  }

  window.addEventListener("scroll", solicitarActualizacion, {
    passive: true,
  });

  window.addEventListener("resize", solicitarActualizacion);
  window.addEventListener("load", solicitarActualizacion);

  actualizarSeccionActiva();
</script>

<script>
  const resplandor = document.querySelector<HTMLElement>(
    ".resplandor-cursor"
  );

  const permitirEfecto = window.matchMedia(
    "(hover: hover) and (pointer: fine) and " +
    "(prefers-reduced-motion: no-preference)"
  );

  if (resplandor) {
    let posicionX = 0;
    let posicionY = 0;
    let cuadroPendiente = false;

    document.addEventListener(
      "pointermove",
      (evento) => {
        if (!permitirEfecto.matches) return;

        posicionX = evento.clientX;
        posicionY = evento.clientY;

        resplandor.classList.add("visible");

        if (cuadroPendiente) return;

        cuadroPendiente = true;

        requestAnimationFrame(() => {
          resplandor.style.setProperty(
            "--cursor-x",
            `${posicionX}px`
          );

          resplandor.style.setProperty(
            "--cursor-y",
            `${posicionY}px`
          );

          cuadroPendiente = false;
        });
      },
      { passive: true }
    );

    document.documentElement.addEventListener(
      "pointerleave",
      () => resplandor.classList.remove("visible")
    );

    window.addEventListener(
      "blur",
      () => resplandor.classList.remove("visible")
    );
  }
</script>

<style is:global>
  :root {
    color-scheme: dark;
    --fondo: #0f172a;
    --texto: #a9bad1;
    --titulo: #f1f5f9;
    --acento: #5eead4;
    --borde: #26364e;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--fondo);
    color: var(--texto);
    font-family: system-ui, sans-serif;
    line-height: 1.7;
  }

  a {
    color: var(--acento);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 6px;
  }

  h1,
  h2 {
    color: var(--titulo);
    line-height: 1.2;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    letter-spacing: -0.05em;
  }

  h2 {
    font-size: 1.65rem;
  }

  .portafolio {
    max-width: 1240px;
    margin: auto;
    padding: 72px 40px;
    display: grid;
    grid-template-columns: minmax(0, 350px) minmax(0, 1fr);
    gap: 80px;
  }

  .perfil {
    align-self: start;
  }

  .enlace-blog {
    font-weight: 600;
  }

  .profesion {
    margin-top: 16px;
  }

  .presentacion {
    margin-top: 32px;
  }

  nav {
    display: grid;
    gap: 18px;
    margin: 44px 0;
  }

  nav a {
    display: flex;
    gap: 24px;
    color: var(--texto);
  }

  nav a:hover,
  nav span {
    color: var(--acento);
  }

  nav span {
    font-size: 0.8rem;
  }

  .descripcion-ingresos,
  small {
    font-size: 0.85rem;
  }

  main section {
    padding-bottom: 36px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--borde);
    scroll-margin-top: 32px;
  }

  .titular {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  footer {
    font-size: 0.8rem;
  }

  @media (max-width: 800px) {
    .portafolio {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 40px 24px;
    }

    nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  .encabezado-proyectos {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 24px;
}

.encabezado-proyectos h2 {
  margin: 0;
}

.encabezado-proyectos > span {
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.lista-proyectos {
  display: grid;
  gap: 14px;
}

/* Ajustes de la portada */
.portafolio {
  max-width: 1360px;
  column-gap: clamp(40px, 6vw, 88px);
}

.perfil {
  min-width: 0;
}

.portafolio > main {
  min-width: 0;
}

.perfil nav a {
  align-items: center;
  transition: color 180ms ease;
}

.perfil nav a::before {
  content: "";
  width: 22px;
  height: 1px;
  background: var(--texto);
  transition: width 180ms ease, background 180ms ease;
}

.perfil nav a:hover,
.perfil nav a[aria-current="location"] {
  color: var(--titulo);
  text-decoration: none;
}

.perfil nav a:hover::before,
.perfil nav a[aria-current="location"]::before {
  width: 40px;
  background: var(--acento);
}

.portafolio > main > section {
  padding-bottom: 40px;
  margin-bottom: 40px;
}



@media (max-width: 800px) {
  .portafolio {
    padding: 36px 22px;
    gap: 48px;
  }

  .perfil nav {
    gap: 18px 12px;
  }

  .perfil nav a {
    gap: 10px;
  }

  .perfil nav a::before {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .perfil nav a,
  .perfil nav a::before {
    transition: none;
  }
}

/* Panel izquierdo visible durante el desplazamiento */
@media (min-width: 801px) {
  .perfil {
    position: sticky;
    top: 24px;
    align-self: start;

    max-height: calc(100dvh - 48px);
    overflow-y: auto;

    padding-right: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--borde) transparent;
  }

  .perfil nav {
    margin: 28px 0;
    gap: 14px;
  }

  .perfil .presentacion {
    margin-top: 22px;
  }
}

/* En celular conservamos el desplazamiento normal */
@media (max-width: 800px) {
  .perfil {
    position: static;
    max-height: none;
    overflow: visible;
    padding-right: 0;
  }
}

.resplandor-cursor {
  display: none;
}

.portafolio {
  position: relative;
  z-index: 1;
}

/* Solo dispositivos con mouse y sin movimiento reducido */
@media (hover: hover) and (pointer: fine) and
  (prefers-reduced-motion: no-preference) {
  .resplandor-cursor {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;

    background: radial-gradient(
      650px circle at var(--cursor-x, 50%) var(--cursor-y, 35%),
      rgba(29, 78, 216, 0.16),
      transparent 80%
    );

    opacity: 0;
    transition: opacity 250ms ease;
  }

  .resplandor-cursor.visible {
    opacity: 1;
  }
}
</style>
