---
import { Icon } from "astro-icon/components";

interface Props {
  nombre: string;
  descripcion: string;
  categoria: string;
  estado: string;
  icono: string;
  color: string;
  enlace?: string;
  tecnologias: {
    nombre: string;
    icono: string;
  }[];
}

const {
  nombre,
  descripcion,
  categoria,
  estado,
  icono,
  color,
  tecnologias,
  enlace,
} = Astro.props;

const estadoClase = estado
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/\s+/g, "-");
---

<article class="tarjeta" >
  {
    enlace && (
      <a
        class="enlace-tarjeta"
        href={enlace}
        target="_blank"
        rel="noreferrer"
        aria-label={`Abrir proyecto ${nombre}`}
      />
    )
  }
  <div class:list={["icono", color]} aria-hidden="true">
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {
        icono === "documento" && (
          <>
            <path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z" />
            <path d="M14 3v5h5M9 12h6M9 16h4" />
          </>
        )
      }

      {
        icono === "pedidos" && (
          <>
            <path d="M3 4h2l3 12h10l3-9H6" />
            <circle cx="9" cy="20" r="1" />
            <circle cx="18" cy="20" r="1" />
          </>
        )
      }

      {
        icono === "datos" && (
          <>
            <path d="M4 13h4v8H4zM10 8h4v13h-4zM16 3h4v18h-4z" />
          </>
        )
      }
    </svg>
  </div>

  <div class="contenido">
    <h3>{nombre}</h3>
    <p>{descripcion}</p>
    <div class="metadatos">
      <small>{categoria}</small>

      <div class="tecnologias" aria-label="Tecnologías utilizadas">
        {
          tecnologias.map((tecnologia) => (
            <span class="tecnologia" title={tecnologia.nombre}>
              <Icon name={tecnologia.icono} width="18" height="18" />
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <span class:list={["estado", estadoClase]}>{estado}</span>
</article>

<style>
  .tarjeta {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 20px;
    border: 1px solid var(--borde);
    border-radius: 10px;
    background: rgb(255 255 255 / 0.015);
  }

  .icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    color: #0f172a;
  }

  .menta {
    background: #5eead4;
  }

  .azul {
    background: #93c5fd;
  }

  .violeta {
    background: #c4b5fd;
  }

  h3 {
    margin: 0 0 6px;
    color: var(--titulo);
    font-size: 1rem;
    line-height: 1.4;
  }

  p {
    margin: 0 0 4px;
    font-size: 0.9rem;
  }

  small {
    font-size: 0.75rem;
  }

  .estado {
    padding: 4px 10px;
    border: 1px solid #526580;
    border-radius: 7px;
    color: var(--titulo);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .disponible {
    border-color: #34d399;
    color: #6ee7b7;
  }

  .propuesto {
    border-color: #f87171;
    color: #fca5a5;
  }

  .ejecucion {
    border-color: #fb923c;
    color: #fdba74;
  }

  @media (max-width: 1050px) {
    .tarjeta {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 14px;
    }

    .icono {
      width: 44px;
      height: 44px;
    }

    .estado {
      grid-column: 2;
      justify-self: start;
    }
  }

  .tarjeta {
  transition:
    background-color 200ms ease,
    border-color 200ms ease,
    box-shadow 200ms ease,
    transform 200ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .tarjeta:hover {
    background-color: rgba(148, 163, 184, 0.07);
    border-color: rgba(94, 234, 212, 0.25);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 12px 30px -18px rgba(0, 0, 0, 0.6);

    transform: translateY(-2px);
  }

  .tarjeta:hover h3 {
    color: var(--acento);
  }
}

@media (prefers-reduced-motion: reduce) {
  .tarjeta {
    transition: none;
  }

  .tarjeta:hover {
    transform: none;
  }
}

.metadatos {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.tecnologias {
  display: flex;
  align-items: center;
  gap: 6px;
}

.tecnologia {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
}

/* Enlaces de la tarjeta */
.tarjeta {
  position: relative;
}

.enlace-tarjeta {
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: inherit;
}

.contenido,
.icono,
.estado {
  position: relative;
  z-index: 2;
  pointer-events: none;
}
</style>